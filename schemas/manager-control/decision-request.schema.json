{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bragi.control-plane/schemas/decision-request.schema.json",
  "title": "Decision Request",
  "description": "A request from executor to manager (or manager to human) when a decision is needed before work can proceed. Includes options, recommendation, and context. The responder writes a decision response back.",
  "type": "object",
  "required": [
    "id", "project", "direction", "type", "from", "to",
    "created_at", "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique decision identifier"
    },
    "project": {
      "type": "string",
      "enum": ["appkit", "portal", "msdk", "router", "bacp"]
    },
    "direction": {
      "type": "string",
      "enum": ["cli_to_manager", "cli_to_human", "manager_to_human"]
    },
    "type": {
      "type": "string",
      "const": "decision_request"
    },
    "from": {
      "type": "string",
      "enum": ["executor", "manager"]
    },
    "to": {
      "type": "string",
      "enum": ["manager", "human"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["title", "context", "options", "recommendation", "deadline"],
      "properties": {
        "title": {
          "type": "string",
          "description": "One-line summary of what needs to be decided"
        },
        "context": {
          "type": "string",
          "description": "Background information. Why this decision is needed now."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "pros", "cons"],
            "properties": {
              "label": {
                "type": "string",
                "description": "Option name"
              },
              "effort": {
                "type": "string",
                "description": "Estimated effort or cost"
              },
              "pros": {
                "type": "array",
                "items": { "type": "string" }
              },
              "cons": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "recommendation": {
          "type": "string",
          "description": "What the requester recommends and why"
        },
        "deadline": {
          "type": "string",
          "description": "When the decision is needed. What blocks on it."
        },
        "blocked_tasks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tasks that cannot proceed until this decision is resolved"
        }
      }
    }
  }
}
