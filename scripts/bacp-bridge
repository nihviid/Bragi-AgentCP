#!/usr/bin/env python3
"""BACP Bridge Helper — Phase 2 CLI tool for the Bragi Agent Control Plane.

Reduces manual copy/paste friction by automating filesystem operations
on the bridge directory (~/.bragi/agent-control-plane/).

Commands:
  status              Show bridge health and queue counts
  next-report         Show oldest pending CLI-to-manager report
  next-instruction    Show oldest pending manager-to-CLI instruction
  write-instruction   Write manager instruction (from stdin) to inbox
  decisions           Show pending and answered decisions
  archive <id>        Move processed message to archive
  ack <id>            Archive a consumed message
  stop                Activate STOP kill switch
  resume              Deactivate STOP kill switch

Usage:
  bacp-bridge status
  bacp-bridge next-report
  bacp-bridge next-instruction
  echo '<json>' | bacp-bridge write-instruction
  bacp-bridge decisions
  bacp-bridge archive <path-or-id>
  bacp-bridge ack <path-or-id>
  bacp-bridge stop
  bacp-bridge resume

Environment:
  BACP_ROOT  Override the default control-plane root path
"""

import json
import os
import sys
import glob
import time
import datetime
import uuid

# ── Paths ──────────────────────────────────────────────────────────────
DEFAULT_ROOT = os.path.expanduser("~/.bragi/agent-control-plane")
ROOT = os.environ.get("BACP_ROOT", DEFAULT_ROOT)

INBOX_MC = os.path.join(ROOT, "inbox", "manager-to-cli")
OUTBOX_CM = os.path.join(ROOT, "outbox", "cli-to-manager")
ARCHIVE_SENT = os.path.join(ROOT, "archive", "sent")
ARCHIVE_RECV = os.path.join(ROOT, "archive", "received")
DECISIONS_PENDING = os.path.join(ROOT, "decisions", "pending")
DECISIONS_ANSWERED = os.path.join(ROOT, "decisions", "answered")
LOGS = os.path.join(ROOT, "logs", "bridge.log")
STOP = os.path.join(ROOT, "STOP")
SCHEMAS = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "schemas", "manager-control"
)

# ── Helpers ────────────────────────────────────────────────────────────

BRIDGE_LOG_ENTRIES = []  # Collect log entries, flush on exit


def log(action, path, result):
    """Queue a log entry to be written on successful exit."""
    ts = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    BRIDGE_LOG_ENTRIES.append(f"{ts} {action} {path} {result}")


def flush_log():
    """Write queued log entries to bridge.log."""
    if not BRIDGE_LOG_ENTRIES:
        return
    try:
        with open(LOGS, "a") as f:
            for entry in BRIDGE_LOG_ENTRIES:
                f.write(entry + "\n")
    except OSError as e:
        print(f"Warning: could not write to {LOGS}: {e}", file=sys.stderr)


def die(msg, code=1):
    flush_log()
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(code)


def ok(msg):
    print(msg)


def is_stopped():
    return os.path.isfile(STOP)


def guard_not_stopped():
    if is_stopped():
        die("Bridge is HALTED. Run 'bacp-bridge resume' or remove STOP to restore.")


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        die(f"File not found: {path}")
    except OSError as e:
        die(f"Cannot read {path}: {e}")


def read_json(path):
    content = read_file(path)
    try:
        return json.loads(content)
    except json.JSONDecodeError as e:
        die(f"Invalid JSON in {path}: {e}")


def list_json_files(directory):
    """Return sorted list of .json files in a directory (oldest first)."""
    if not os.path.isdir(directory):
        return []
    files = glob.glob(os.path.join(directory, "*.json"))
    files.sort(key=os.path.getmtime)
    return files


def count_files(directory):
    return len(list_json_files(directory))


def now_utc():
    return datetime.datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")


def make_nonce():
    return uuid.uuid4().hex[:4]


def make_message_id(project, role):
    pid = os.getpid()
    nonce = make_nonce()
    return f"{now_utc()}~{project}~{role}~p{pid}~{nonce}"


def ensure_dirs():
    for d in [INBOX_MC, OUTBOX_CM, ARCHIVE_SENT, ARCHIVE_RECV,
              DECISIONS_PENDING, DECISIONS_ANSWERED]:
        os.makedirs(d, exist_ok=True)


# ── Minimal Validation ─────────────────────────────────────────────────

INSTRUCTION_REQUIRED = [
    "command", "instruction", "model_selection"
]

INSTRUCTION_MODEL_REQUIRED = [
    "manager_model", "executor_model", "memory_action", "reason"
]

VALID_COMMANDS = {
    "continue", "pause", "stop", "redirect", "approve", "reject",
    "request_status", "request_diff", "request_tests", "request_pr_status",
    "compact_memory", "clear_memory", "escalate_to_human"
}


def validate_instruction(data):
    """Basic validation of a manager instruction JSON. Returns list of errors."""
    errors = []
    if not isinstance(data, dict):
        errors.append("Root value must be a JSON object")
        return errors

    for field in INSTRUCTION_REQUIRED:
        if field not in data:
            errors.append(f"Missing required field: '{field}'")

    if "command" in data and data["command"] not in VALID_COMMANDS:
        errors.append(f"Invalid command '{data['command']}'. Valid: {', '.join(sorted(VALID_COMMANDS))}")

    ms = data.get("model_selection", {})
    if not isinstance(ms, dict):
        errors.append("'model_selection' must be a JSON object")
    else:
        for field in INSTRUCTION_MODEL_REQUIRED:
            if field not in ms:
                errors.append(f"Missing required field: 'model_selection.{field}'")

    return errors


def validate_report(data):
    """Basic validation of an executor report. Returns list of errors."""
    errors = []
    if not isinstance(data, dict):
        errors.append("Root value must be a JSON object")
        return errors
    if "payload" not in data:
        errors.append("Missing required field: 'payload'")
    return errors


# ── Commands ───────────────────────────────────────────────────────────

def cmd_status():
    guard_not_stopped()

    stop_status = "ACTIVE"
    stop_reason = None
    if is_stopped():
        stop_status = "HALTED"
        try:
            content = read_file(STOP)
            stop_reason = content.strip().split("\n")[0] if content else "unknown"
        except Exception:
            stop_reason = "unknown"

    inbox_count = count_files(INBOX_MC)
    outbox_count = count_files(OUTBOX_CM)
    decisions_pending = count_files(DECISIONS_PENDING)
    decisions_answered = count_files(DECISIONS_ANSWERED)

    last_log = "N/A"
    try:
        if os.path.isfile(LOGS):
            with open(LOGS) as f:
                lines = f.readlines()
                if lines:
                    last_log = lines[-1].strip()
    except OSError:
        pass

    print(f"Bridge:                {stop_status}")
    if stop_reason:
        print(f"  Reason:              {stop_reason}")
    print(f"Control root:          {ROOT}")
    print(f"STOP:                  {'present' if is_stopped() else 'not present'}")
    print(f"Pending instructions:  {inbox_count}  (inbox/manager-to-cli/)")
    print(f"Pending reports:       {outbox_count}  (outbox/cli-to-manager/)")
    print(f"Pending decisions:     {decisions_pending}  (decisions/pending/)")
    print(f"Answered decisions:    {decisions_answered}  (decisions/answered/)")
    print(f"Latest log:            {last_log}")

    log("status", ROOT, "ok")


def cmd_next_report():
    guard_not_stopped()

    files = list_json_files(OUTBOX_CM)
    if not files:
        ok("No pending reports in outbox/cli-to-manager/.")
        return

    path = files[0]
    filename = os.path.basename(path)
    data = read_json(path)
    proj = data.get("project", "?")
    dtype = data.get("direction", "?")
    mtype = data.get("type", "?")
    needs_resp = data.get("requires_response", "?")
    ts = data.get("created_at", "?")

    errors = validate_report(data)

    sep = "─" * 60
    print(sep)
    print(f"PENDING REPORT: {filename}")
    print(f"Project: {proj} | Direction: {dtype} | Type: {mtype}")
    print(f"Created: {ts} | Requires response: {needs_resp}")
    if errors:
        print(f"Warnings: {'; '.join(errors)}")
    print(sep)
    print("")
    print(json.dumps(data, indent=2))
    print("")
    print(sep)
    print(" COPY TO CHATGPT")
    print("   Copy the JSON above and paste into ChatGPT.")
    print("   After ChatGPT responds, run:")
    print("     bacp-bridge write-instruction < <response-file>")
    print("   Or pipe the response directly:")
    print("     cat /tmp/chatgpt-response.json | bacp-bridge write-instruction")
    print(sep)

    log("next-report", path, "ok")


def cmd_write_instruction():
    guard_not_stopped()

    try:
        raw = sys.stdin.read()
    except KeyboardInterrupt:
        die("Interrupted.")

    if not raw or not raw.strip():
        die("No input received on stdin. Pipe a manager instruction JSON.")

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"Invalid JSON on stdin: {e}")

    errors = validate_instruction(data)
    if errors:
        for e in errors:
            print(f"  Validation error: {e}", file=sys.stderr)
        die("Instruction rejected. Fix errors and try again.")

    project = data.get("project", "bacp")
    command = data.get("command", "instruction")
    mid = make_message_id(project, "manager")
    filename = f"{mid}.{command}.json"
    dest = os.path.join(INBOX_MC, filename)

    try:
        with open(dest, "w") as f:
            json.dump(data, f, indent=2)
    except OSError as e:
        die(f"Cannot write to {dest}: {e}")

    print(f"Written: {dest}")
    log("write-instruction", dest, "ok")


def cmd_archive(target):
    guard_not_stopped()

    if not target:
        die("Specify a message path or ID to archive.")

    # Resolve target to an actual file path
    path = None
    if os.path.isfile(target):
        path = target
    else:
        # Try to find by ID substring
        for directory in [INBOX_MC, OUTBOX_CM, DECISIONS_PENDING]:
            for f in list_json_files(directory):
                if target in os.path.basename(f):
                    path = f
                    break
            if path:
                break

    if not path:
        die(f"No message found matching '{target}'")

    filename = os.path.basename(path)
    # Determine archive subdirectory based on direction
    direction = ""
    if "manager-to-cli" in path or "manager_to_cli" in path:
        archive_dir = ARCHIVE_RECV
        direction = "received"
    elif "cli-to-human" in path or "cli_to_human" in path:
        archive_dir = ARCHIVE_SENT
        direction = "sent"
    elif "cli-to-manager" in path or "cli_to_manager" in path:
        archive_dir = ARCHIVE_SENT
        direction = "sent"
    elif "pending" in path:
        archive_dir = ARCHIVE_RECV
        direction = "received"
    else:
        archive_dir = ARCHIVE_SENT
        direction = "sent"

    dest = os.path.join(archive_dir, filename)
    suffix = 1
    while os.path.exists(dest):
        name, ext = os.path.splitext(filename)
        dest = os.path.join(archive_dir, f"{name}.{suffix}{ext}")
        suffix += 1

    try:
        os.rename(path, dest)
    except OSError as e:
        die(f"Cannot archive {path} → {dest}: {e}")

    print(f"Archived: {path}")
    print(f"    → {dest}")
    log("archive", f"{path} → {dest}", "ok")


# ── P1 Commands ────────────────────────────────────────────────────────

def cmd_next_instruction():
    guard_not_stopped()

    files = list_json_files(INBOX_MC)
    if not files:
        ok("No pending instructions in inbox/manager-to-cli/.")
        return

    path = files[0]
    filename = os.path.basename(path)
    data = read_json(path)
    cmd = data.get("command", data.get("type", "?"))
    proj = data.get("project", "?")
    ts = data.get("created_at", "?")

    sep = "─" * 60
    print(sep)
    print(f"PENDING INSTRUCTION: {filename}")
    print(f"Project: {proj} | Command: {cmd}")
    print(f"Created: {ts}")
    print(sep)
    print("")
    print(json.dumps(data, indent=2))
    print("")
    print(sep)
    print(" PROCESS THIS INSTRUCTION")
    print("   Read the instruction above and continue working.")
    print("   After completing, run:")
    print("     bacp-bridge ack <id>")
    print("   Then write a status report to outbox/cli-to-manager/.")
    print(sep)

    log("next-instruction", path, "ok")


def cmd_decisions():
    guard_not_stopped()

    pending_files = list_json_files(DECISIONS_PENDING)
    answered_files = list_json_files(DECISIONS_ANSWERED)

    print(f"Pending decisions:  {len(pending_files)}")
    print(f"Answered decisions: {len(answered_files)}")
    print("")

    if pending_files:
        print("─" * 60)
        print("PENDING DECISIONS")
        print("─" * 60)
        for f in pending_files:
            try:
                data = read_json(f)
                title = data.get("payload", {}).get("title", data.get("subject", "?"))
                proj = data.get("project", "?")
                fname = os.path.basename(f)
                print(f"  • [{proj}] {title}")
                print(f"    {fname}")
            except Exception:
                print(f"  • {os.path.basename(f)} (unreadable)")

    if answered_files:
        print("")
        print("─" * 60)
        print("ANSWERED DECISIONS")
        print("─" * 60)
        for f in reversed(answered_files[-10:]):  # show last 10
            try:
                data = read_json(f)
                title = data.get("payload", {}).get("title", data.get("subject", "?"))
                proj = data.get("project", "?")
                fname = os.path.basename(f)
                print(f"  • [{proj}] {title}")
                print(f"    {fname}")
            except Exception:
                pass
    print("")

    log("decisions", ROOT, "ok")


def cmd_stop():
    if is_stopped():
        ok(f"Bridge is already HALTED. {STOP} exists.")
        return

    print("⚠  WARNING: This will halt ALL bridge operations.", file=sys.stderr)
    print(f"  STOP will be written to: {STOP}", file=sys.stderr)
    print(file=sys.stderr)

    try:
        response = input("Are you sure? [y/N]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print("")
        die("Cancelled.")

    if response not in ("y", "yes"):
        ok("Stop cancelled.")
        return

    content = (
        f"Bridge halted by human at {datetime.datetime.utcnow().isoformat()}Z\n"
        f"Reason: invoked via bacp-bridge stop\n"
        f"To resume: run 'bacp-bridge resume' or delete this file.\n"
    )
    try:
        with open(STOP, "w") as f:
            f.write(content)
    except OSError as e:
        die(f"Cannot write STOP: {e}")

    print("✓ Bridge is now HALTED.")
    log("stop", STOP, "ok")


def cmd_resume():
    if not is_stopped():
        ok("Bridge is already ACTIVE. No STOP file present.")
        return

    print("⚠  This will reactivate bridge operations.", file=sys.stderr)
    try:
        response = input("Resume bridge operations? [y/N]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print("")
        die("Cancelled.")

    if response not in ("y", "yes"):
        ok("Resume cancelled.")
        return

    try:
        os.remove(STOP)
    except OSError as e:
        die(f"Cannot remove STOP: {e}")

    print("✓ Bridge is now ACTIVE.")
    log("resume", STOP, "ok")


def cmd_ack(target):
    """Archive a consumed message (acknowledgement). Same as archive but with ack semantics."""
    cmd_archive(target)
    log("ack", target, "ok")


# ── Main ───────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        sys.exit(0)

    # Ensure required directories exist
    ensure_dirs()

    command = sys.argv[1]
    try:
        if command == "status":
            cmd_status()
        elif command == "next-report":
            cmd_next_report()
        elif command == "write-instruction":
            cmd_write_instruction()
        elif command == "next-instruction":
            cmd_next_instruction()
        elif command == "decisions":
            cmd_decisions()
        elif command == "stop":
            cmd_stop()
        elif command == "resume":
            cmd_resume()
        elif command == "ack":
            if len(sys.argv) < 3:
                die("Usage: bacp-bridge ack <message-path-or-id>")
            cmd_ack(sys.argv[2])
        elif command == "archive":
            if len(sys.argv) < 3:
                die("Usage: bacp-bridge archive <message-path-or-id>")
            cmd_archive(sys.argv[2])
        elif command in ("help", "--help", "-h"):
            print(__doc__.strip())
        else:
            die(f"Unknown command: {command}. See bacp-bridge help.")
    finally:
        flush_log()


if __name__ == "__main__":
    main()
