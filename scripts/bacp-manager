#!/usr/bin/env python3
"""BACP Manager — lightweight AI manager process for the control loop.

Runs in the Manager pane. No project filesystem access — only the bridge.
Reads reports, calls LLM with memory context, writes instructions.

Environment:
  ANTHROPIC_API_KEY    or ANTHROPIC_AUTH_TOKEN
  ANTHROPIC_BASE_URL   (optional, default: https://api.anthropic.com)
  ANTHROPIC_MODEL      (optional, default: claude-sonnet-4-20250514)
  BACP_ROOT            (optional, default: ~/.bragi/agent-control-plane)
"""

import json
import os
import sys
import glob
import datetime

# ── Configuration ────────────────────────────────────────────────────
BACP_ROOT = os.environ.get("BACP_ROOT", os.path.expanduser("~/.bragi/agent-control-plane"))
MEMORY_DIR = os.path.join(BACP_ROOT, "memory")
MEMORY_LOG = os.path.join(MEMORY_DIR, "manager-log.jsonl")
OUTBOX = os.path.join(BACP_ROOT, "outbox", "cli-to-manager")
INBOX = os.path.join(BACP_ROOT, "inbox", "manager-to-cli")

# Project: auto-detect from BACP_ROOT, or override via env/args
PROJECT = os.environ.get("BACP_PROJECT", "BAC")
NOTIFY_FLAG = os.path.join(BACP_ROOT, f"NOTIFY-MANAGER-{PROJECT.upper()}")

API_KEY = os.environ.get("ANTHROPIC_AUTH_TOKEN") or os.environ.get("ANTHROPIC_API_KEY") or ""
API_URL = os.environ.get("ANTHROPIC_BASE_URL", "https://api.anthropic.com")
API_MODEL = os.environ.get("ANTHROPIC_MODEL", "claude-sonnet-4-20250514")

# Detect API format: Anthropic /v1/messages or OpenAI /chat/completions
# Default to Anthropic format. Use OpenAI if URL contains "litellm" or forced.
USE_OPENAI_FORMAT = os.environ.get("BACP_API_FORMAT", "").lower() == "openai" or "litellm" in API_URL.lower()

PROMPT = """You are the Manager AI. You control an Executor AI through a structured message bus. You are authoritative over what gets done. The Executor implements.

## MOS Rules

- One task = one objective. Every instruction needs: objective, scope, constraints, success criteria.
- The Executor owns bounded execution only. The Executor cannot expand scope, make architecture decisions, or modify files outside scope.
- The Manager owns direction, quality, verification.
- The Manager must verify the Executor's report before issuing the next instruction.
- Tests/checks must pass or be explicitly justified.

## Your Job

Read the report below. If a previous decision exists in the memory log, consider it before deciding.

Write a SINGLE JSON object with EXACTLY these fields (no commentary, no markdown, no code fences):

{
  "command": "redirect" or "continue" or "approve" or "reject",
  "instruction": "Clear task description with objective, scope, constraints",
  "project": "portal" or "appkit" or "msdk" or "agentcp" or "router",
  "model_selection": {
    "manager_model": "sonnet",
    "executor_model": "sonnet",
    "memory_action": "keep",
    "reason": "why this model choice"
  }
}

Use "approve" if the report says the task is complete and verified.
Use "redirect" if the executor needs to do something next.
Do not use "continue" unless a task is in progress and needs more work.

## Memory

Previous decisions are provided below. Use them to maintain consistency.
"""

# ── Helpers ───────────────────────────────────────────────────────────

def log(msg):
    print(f"[manager] {msg}", file=sys.stderr)


def now_iso():
    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")


def read_memory(limit=10):
    """Read the last N entries from the memory log."""
    if not os.path.isfile(MEMORY_LOG):
        return []
    entries = []
    with open(MEMORY_LOG) as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    entries.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    return entries[-limit:]


def write_memory(entry):
    """Append an entry to the memory log."""
    os.makedirs(MEMORY_DIR, exist_ok=True)
    with open(MEMORY_LOG, "a") as f:
        f.write(json.dumps(entry) + "\n")


def find_latest_report():
    """Find the newest pending report in outbox/."""
    if not os.path.isdir(OUTBOX):
        return None
    files = sorted(glob.glob(os.path.join(OUTBOX, "*.json")), key=os.path.getmtime)
    if not files:
        return None
    path = files[0]
    with open(path) as f:
        data = json.load(f)
    return {"path": path, "data": data, "filename": os.path.basename(path)}


def call_llm(messages, retries=3):
    """Call the LLM API via Anthropic or OpenAI-compatible format.
    Retries on 5xx errors with exponential backoff (1s, 2s, 4s)."""
    import urllib.request
    import urllib.error
    import time as _time

    for attempt in range(retries + 1):
        if attempt > 0:
            wait = 2 ** (attempt - 1)
            log(f"API retry {attempt}/{retries} after {wait}s")
            _time.sleep(wait)

        if USE_OPENAI_FORMAT:
            headers = {"Content-Type": "application/json", "Authorization": f"Bearer {API_KEY}"}
            oai_messages = [{"role": m["role"], "content": m["content"]} for m in messages]
            body = json.dumps({"model": API_MODEL, "max_tokens": 4096, "messages": oai_messages}).encode()
            url = f"{API_URL}/chat/completions"
            response_key = ["choices", 0, "message", "content"]
        else:
            headers = {"Content-Type": "application/json", "x-api-key": API_KEY, "anthropic-version": "2023-06-01"}
            body = json.dumps({"model": API_MODEL, "max_tokens": 4096, "messages": messages}).encode()
            url = f"{API_URL}/v1/messages"
            response_key = ["content", 0, "text"]

        req = urllib.request.Request(url, data=body, headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                result = json.loads(resp.read())
                val = result
                for key in response_key:
                    val = val[key]
                return val
        except urllib.error.HTTPError as e:
            code = e.code
            detail = e.read().decode()[:200]
            if 500 <= code < 600:
                log(f"API error {code}: {detail[:80]} (retriable)")
                continue
            log(f"API error {code}: {detail[:80]} (fatal)")
            return None
        except Exception as e:
            log(f"API error: {e}")
            if attempt < retries:
                continue
            return None

    log("API failed after all retries.")
    return None


def write_instruction(instruction_text, report_filename):
    """Parse LLM response and write instruction to inbox."""
    # Strip markdown code fences if present
    text = instruction_text.strip()
    if text.startswith("```"):
        text = text.split("\n", 1)[1]
    if text.endswith("```"):
        text = text.rsplit("```", 1)[0]
    text = text.strip()

    try:
        data = json.loads(text)
    except json.JSONDecodeError as e:
        log(f"LLM response was not valid JSON: {e}")
        log(f"Response was: {text[:200]}...")
        return None

    # Validate required fields
    if "command" not in data or "instruction" not in data:
        log("LLM response missing required fields (command, instruction)")
        return None
    if "model_selection" not in data:
        log("LLM response missing model_selection — adding default")
        data["model_selection"] = {
            "manager_model": "sonnet",
            "executor_model": "sonnet",
            "memory_action": "keep",
            "reason": "auto-generated by manager"
        }

    project = data.get("project", "unknown")
    command = data.get("command", "instruction")
    now = now_iso().replace(":", "").replace("-", "")
    mid = f"{now}~{project}~manager~p{os.getpid()}"
    filename = f"{mid}.{command}.json"
    dest = os.path.join(INBOX, filename)

    with open(dest, "w") as f:
        json.dump(data, f, indent=2)

    log(f"Instruction written: {dest}")
    return filename


def main():
    log(f"Starting (model={API_MODEL}, url={API_URL})")

    # Find latest report
    report = find_latest_report()
    if not report:
        log("No pending reports.")
        return

    log(f"Report found: {report['filename']}")
    import subprocess as _sp2
    _sp2.run(["bacp-bridge", "log-activity", "manager", PROJECT, "started", f"Processing: {report['filename']}"],
             capture_output=True, timeout=10)

    # Read memory
    memory = read_memory(limit=10)

    # Build messages
    messages = [{"role": "user", "content": PROMPT}]

    if memory:
        memory_text = "## Previous decisions:\n"
        for entry in memory:
            memory_text += f"- {entry.get('timestamp', '?')}: {entry.get('report_task', '?')} → {entry.get('command', '?')}\n"
        messages.append({"role": "assistant", "content": "I will review the memory first."})
        messages.append({"role": "user", "content": memory_text})

    report_text = f"## Current Report\n\nFilename: {report['filename']}\n\n{json.dumps(report['data'], indent=2)}"
    messages.append({"role": "user", "content": report_text})

    # Call LLM
    log("Calling LLM...")
    response = call_llm(messages)
    if response is None:
        log("LLM returned no response. Skipping cycle.")
        return
    log(f"LLM responded ({len(response)} chars)")

    # Write instruction
    instr_filename = write_instruction(response, report["filename"])

    # Write to memory
    write_memory({
        "timestamp": now_iso(),
        "report_filename": report["filename"],
        "report_task": report["data"].get("payload", {}).get("project_state", {}).get("task", {}).get("description", "unknown"),
        "command": json.loads(response).get("command", "unknown") if instr_filename else "error",
        "instruction_file": instr_filename or "failed",
    })

    import subprocess as _sp3
    if instr_filename:
        log("Cycle complete.")
        _sp3.run(["bacp-bridge", "log-activity", "manager", PROJECT, "complete",
                  f"Wrote: {instr_filename}"], capture_output=True, timeout=10)
    else:
        log("Cycle failed — no instruction written.")
        _sp3.run(["bacp-bridge", "log-activity", "manager", PROJECT, "failed",
                  "No instruction written"], capture_output=True, timeout=10)


if __name__ == "__main__":
    # Parse --project flag
    if "--project" in sys.argv:
        idx = sys.argv.index("--project")
        if idx + 1 < len(sys.argv):
            PROJECT = sys.argv[idx + 1]
            NOTIFY_FLAG = os.path.join(BACP_ROOT, f"NOTIFY-MANAGER-{PROJECT.upper()}")
    elif os.environ.get("BACP_PROJECT"):
        PROJECT = os.environ.get("BACP_PROJECT")
        NOTIFY_FLAG = os.path.join(BACP_ROOT, f"NOTIFY-MANAGER-{PROJECT.upper()}")

    if "--watch" in sys.argv:
        import time as _time
        interval = 5
        print(f"Manager watch started (polling every {interval}s). Ctrl+C to stop.")
        try:
            cycle_count = 0
            heartbeat_dir = os.path.join(BACP_ROOT, "heartbeats")
            while True:
                cycle_count += 1
                # Record heartbeat
                os.makedirs(heartbeat_dir, exist_ok=True)
                hb_file = os.path.join(heartbeat_dir, f"HEARTBEAT-MANAGER-{PROJECT.upper()}")
                try:
                    with open(hb_file, "w") as f:
                        f.write(now_iso())
                except OSError:
                    pass
                # Context pressure: auto-stop at cycle limit
                if cycle_count > 30:
                    log(f"Cycle {cycle_count}: stopping for fresh context. Restart to continue.")
                    break
                if os.path.isfile(NOTIFY_FLAG):
                    try:
                        os.remove(NOTIFY_FLAG)
                    except OSError:
                        pass
                    cycle_count = 0
                    log(f"Processing report (cycle {cycle_count})")
                    import subprocess as _sp
                    _sp.run(["bacp-bridge", "activity"], capture_output=True)
                    try:
                        main()
                    except Exception as e:
                        log(f"Error in main: {e}")
                        import traceback
                        log(traceback.format_exc())
                _time.sleep(interval)
        except KeyboardInterrupt:
            print("\nManager watch stopped.")
    else:
        main()
