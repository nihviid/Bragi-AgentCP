#!/usr/bin/env python3
"""BACP Trio — iTerm2 multi-agent layout for any Bragi project.

Opens one iTerm2 window with three panes:
  ┌──────────────────┬──────────────────────────┐
  │  MANAGER         │  EXECUTOR                │
  │  (message bus)   │  (project + LLM)         │
  │                  ├──────────────────────────┤
  │                  │  TERMINAL                │
  │                  │  (git, npm, playwright)  │
  └──────────────────┴──────────────────────────┘

Usage:
  bacp-trio portal          Launch Portal trio (default)
  bacp-trio appkit          Launch AppKit trio
  bacp-trio msdk            Launch mSDK trio
  bacp-trio agentcp         Launch AgentCP trio
  bacp-trio router          Launch Router trio (clone required)
  bacp-trio --help          Show help
"""

import os
import sys
import asyncio

try:
    import iterm2
except ImportError:
    print("Error: iterm2 Python module not installed.", file=sys.stderr)
    print("Run: pip3 install iterm2", file=sys.stderr)
    sys.exit(1)

# Project home directories
HOME = os.path.expanduser("~/Desktop/Antigravity")

PROJECTS = {
    "agentcp": os.path.join(HOME, "Bragi-AgentCP"),
    "portal":  os.path.join(HOME, "Bragi-portal"),
    "appkit":  os.path.join(HOME, "Bragi-AppKit"),
    "msdk":    os.path.join(HOME, "msdk-ios"),
    "router":  os.path.join(HOME, "Bragi-RouterAI"),
}

PROJECT_NAMES = {
    "agentcp": "AgentCP",
    "portal":  "Portal",
    "appkit":  "AppKit",
    "msdk":    "mSDK",
    "router":  "Router",
}

BACP_ROOT = os.path.expanduser("~/.bragi/agent-control-plane")

def manager_root(project):
    """Per-project isolation directory so multiple trios don't conflict."""
    return f"/tmp/bacp-manager-{project}"


async def setup_pane(session, title, cwd, startup_cmds=None):
    """Configure a pane with title, directory, and optional startup commands."""
    await session.async_set_name(title)
    # Change to working directory
    await session.async_send_text(f"cd {cwd}\n")
    await asyncio.sleep(0.3)
    # Send startup commands
    if startup_cmds:
        for cmd in startup_cmds:
            await session.async_send_text(cmd + "\n")
            await asyncio.sleep(0.5)


async def main(connection):
    app = await iterm2.async_get_app(connection)

    # Determine project from --project flag or first positional arg
    project = None
    if "--project" in sys.argv:
        idx = sys.argv.index("--project")
        if idx + 1 < len(sys.argv):
            project = sys.argv[idx + 1].lower()
    elif len(sys.argv) >= 2 and sys.argv[1] in PROJECTS:
        project = sys.argv[1].lower()

    if not project or project not in PROJECTS:
        print(f"Usage: bacp-trio [project]", file=sys.stderr)
        print(f"", file=sys.stderr)
        print(f"Projects:", file=sys.stderr)
        for name in sorted(PROJECTS.keys()):
            path = PROJECTS[name]
            if path and os.path.isdir(path):
                print(f"  {name}", file=sys.stderr)
            elif path:
                print(f"  {name}  (needs clone: gh repo clone nihviid/{path.split('/')[-1]} {path})", file=sys.stderr)
            else:
                print(f"  {name}  (no path set)", file=sys.stderr)
        print(f"", file=sys.stderr)
        print(f"Examples:", file=sys.stderr)
        print(f"  bacp-trio portal", file=sys.stderr)
        print(f"  bacp-trio appkit", file=sys.stderr)
        print(f"  bacp-trio msdk", file=sys.stderr)
        print(f"  bacp-trio agentcp", file=sys.stderr)
        return

    project_path = PROJECTS[project]
    project_name = PROJECT_NAMES[project]

    if not project_path:
        print(f"Error: No path configured for {project_name}.", file=sys.stderr)
        return

    missing = not os.path.isdir(project_path)
    if missing:
        print(f"Warning: {project_name} not cloned locally.", file=sys.stderr)
        print(f"  Clone it first: gh repo clone nihviid/{project_path.split('/')[-1]} {project_path}", file=sys.stderr)
        print(f"  Layout will still open, but cd may fail.\n", file=sys.stderr)

    # Ensure manager isolation directory exists
    os.makedirs(manager_root(project), exist_ok=True)

    # Write isolated CLAUDE.md for Manager (restricted to bridge operations)
    manager_claude = os.path.join(manager_root(project), "CLAUDE.md")
    with open(manager_claude, "w") as f:
        f.write(f"""# Manager Agent — {project_name}

Your role is manager for {project_name}. You control the executor through the message bus.

**Access:**
- Message bus: {BACP_ROOT}
- bacp-bridge commands only

**Project:** {project_name} only — ignore reports from other projects.

**You CANNOT:**
- Read or modify project files
- Run terminal commands (git, npm, pytest)
- Write code

**Your job:**
1. Read reports for {project_name} from `bacp-bridge next-report`
2. Verify the report's project field matches {project_name} before acting
3. Decompose tasks into clear instructions
4. Write instructions via `bacp-bridge write-instruction`
5. Verify executor reports against MOS quality gates
6. Approve or redirect based on results

**Rules:**
- One task = one objective
- Every instruction needs: objective, scope, constraints, success criteria
- Do not expand scope mid-task
- Route model selection: Haiku for routing, Sonnet for execution, Opus only for architecture/risk

**Running concurrently:** Other project trios may be active. Only handle {project_name} reports.
""")

    # Write CLAUDE.md for Executor
    executor_claude = None
    if project_path:
        executor_claude = os.path.join(project_path, "CLAUDE.md")
        # Don't overwrite project's existing CLAUDE.md — append trio-specific notes
        existing = ""
        if os.path.isfile(executor_claude):
            with open(executor_claude) as f:
                existing = f.read()
        if "# Trio" not in existing:
            with open(executor_claude, "a") as f:
                f.write(f"""
# Trio Execution Notes

You are the executor in a multi-agent trio with manager and terminal panes.

**Protocol:**
- Read instructions from: `bacp-bridge next-instruction`
- ACK after reading: `bacp-bridge ack <id>`
- Run terminal commands in the Terminal pane (bottom-right)
- Report back via: `bacp-bridge write-report --ack-source <id>`

**Boundaries:**
- Do not expand task scope
- Do not make architecture decisions without manager approval
- Surface blockers immediately in reports
""")

    # Create new window
    window = await iterm2.Window.async_create(connection)
    await asyncio.sleep(0.5)

    # Get initial session (becomes left pane = Manager)
    manager_session = window.current_tab.current_session

    # Split vertically: right pane
    right_session = await manager_session.async_split_pane(vertical=True)
    await asyncio.sleep(0.3)

    # Split right pane horizontally: top = Executor, bottom = Terminal
    terminal_session = await right_session.async_split_pane(vertical=False)
    await asyncio.sleep(0.3)
    executor_session = right_session  # top-right after split

    # --- Setup Manager Pane (left) ---
    # Lightweight manager process — no Claude Code, no project access
    # Read API config from ~/.zshrc so the pane gets the same env as new terminals
    def _read_zshrc(key):
        """Read an export line from ~/.zshrc."""
        try:
            with open(os.path.expanduser("~/.zshrc")) as f:
                for line in f:
                    if line.startswith(f"export {key}="):
                        val = line.split("=", 1)[1].strip().strip('"').strip("'")
                        return val
        except Exception:
            pass
        return os.environ.get(key.replace("ANTHROPIC_", "ANTHROPIC_AUTH_"), "")

    api_key = _read_zshrc("ANTHROPIC_API_KEY")
    api_url = _read_zshrc("ANTHROPIC_BASE_URL")
    api_model = _read_zshrc("ANTHROPIC_MODEL")
    manager_startup = [
        f"export BACP_ROOT={BACP_ROOT}",
        f"export ANTHROPIC_API_KEY={api_key}",
        f"export ANTHROPIC_BASE_URL={api_url}",
        f"export ANTHROPIC_MODEL={api_model}",
        "echo 'Starting Manager AI (bacp-manager)...'",
        "bacp-manager --watch",
    ]
    await setup_pane(manager_session, "Manager", manager_root(project), manager_startup)

    # --- Setup Executor Pane (top-right) ---
    # Automated executor — no Claude Code, calls LLM directly, runs commands
    if project_path:
        executor_startup = [
            f"export BACP_ROOT={BACP_ROOT}",
            f"export ANTHROPIC_API_KEY={api_key}",
            f"export ANTHROPIC_BASE_URL={api_url}",
            f"export ANTHROPIC_MODEL={api_model}",
            "echo 'Starting Executor AI (bacp-executor)...'",
            "bacp-executor --watch",
        ]
        await setup_pane(executor_session, "Executor", project_path, executor_startup)
    else:
        await setup_pane(executor_session, "Executor", manager_root(project),
                        ["echo 'No project path set'"])

    # --- Setup Terminal Pane (bottom-right) ---
    if project_path:
        await setup_pane(terminal_session, "Terminal", project_path, None)
    else:
        await setup_pane(terminal_session, "Terminal", os.path.expanduser("~"), None)

    print(f"BACP Trio launched: {project}")
    print(f"  Manager:  {manager_root(project)}")
    print(f"  Executor: {project_path or '(not set)'}")
    print(f"  Terminal: {project_path or '(not set)'}")
    print(f"  Bus:      {BACP_ROOT}")


if __name__ == "__main__":
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__.strip())
        sys.exit(0)

    try:
        iterm2.run_until_complete(main)
    except Exception as e:
        if "Connection" in type(e).__name__:
            print(f"Error: Cannot connect to iTerm2.", file=sys.stderr)
            print(f"Make sure iTerm2 is running and Python API is enabled:", file=sys.stderr)
            print(f"  iTerm2 → Settings → General → Magic → Enable Python API", file=sys.stderr)
        else:
            print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
